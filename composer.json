{
    "name": "samsiani/codeon-multilingual",
    "description": "Lightweight multilingual plugin for WordPress and WooCommerce. WPML-compatible, fraction of the weight.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://codeon.ge/plugins/codeon-multilingual",
    "authors": [
        {
            "name": "Samsiani / CodeOn",
            "homepage": "https://codeon.ge"
        }
    ],
    "require": {
        "php": ">=8.1",
        "automattic/jetpack-autoloader": "^3.0 || ^4.0 || ^5.0",
        "yahnis-elsts/plugin-update-checker": "^5.6"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mockery/mockery": "^1.6",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Samsiani\\CodeonMultilingual\\": "src/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/phpcs -n -q --no-colors --report=summary",
        "lint:fix": "vendor/bin/phpcbf",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G",
        "test": "vendor/bin/phpunit --testsuite=Unit",
        "test:integration:setup": "bash scripts/install-wp-tests.sh wordpress_test root root 127.0.0.1:3306 latest latest",
        "test:integration": "vendor/bin/phpunit --bootstrap tests/Integration/bootstrap.php --fail-on-risky --fail-on-warning tests/Integration",
        "package:test": "bash scripts/package-test.sh"
    },
    "config": {
        "allow-plugins": {
            "automattic/jetpack-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
